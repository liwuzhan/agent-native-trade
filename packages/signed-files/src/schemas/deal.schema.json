{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trade.dev/schemas/deal.schema.json",
  "title": "DEAL",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "object_type", "body", "body_hash", "signatures"],
  "properties": {
    "protocol": { "const": "agent-trade/0.2" },
    "object_type": { "const": "DEAL" },
    "body_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/signature" }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_id", "buyer", "seller", "subject", "settlement", "fulfillment"],
      "properties": {
        "trade_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "buyer": { "$ref": "#/$defs/agentId" },
        "seller": { "$ref": "#/$defs/agentId" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["listing_ref", "description", "quantity", "acceptance_conditions"],
          "properties": {
            "listing_ref": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "quantity": { "type": "integer", "minimum": 1 },
            "acceptance_conditions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        "settlement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset", "method"],
          "properties": {
            "asset": { "type": "string", "minLength": 1 },
            "amount": { "$ref": "#/$defs/decimal" },
            "method": { "type": "string", "minLength": 1 },
            "executor_ref": { "type": "string" },
            "provider_ref": { "type": "string" },
            "escrow_ref": { "type": "string" },
            "insurer_ref": { "type": "string" },
            "notary_ref": { "type": "string" },
            "consideration": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["item", "quantity"],
                "properties": {
                  "item": { "type": "string" },
                  "quantity": { "type": "number", "exclusiveMinimum": 0 },
                  "denomination": { "$ref": "#/$defs/decimal" },
                  "asset": { "type": "string" }
                }
              }
            }
          }
        },
        "fulfillment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deadline", "destination_ref", "carrier_ref"],
          "properties": {
            "deadline": { "type": "string", "format": "date-time" },
            "destination_ref": { "type": "string" },
            "carrier_ref": { "type": "string" }
          }
        },
        "dispute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider_ref": { "type": "string" },
            "rules_ref": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "agentId": { "type": "string", "minLength": 1 },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer", "algorithm", "signature", "issued_at"],
      "properties": {
        "signer": { "$ref": "#/$defs/agentId" },
        "algorithm": { "const": "Ed25519" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

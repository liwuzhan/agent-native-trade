{
  "name": "@agent-trade/signed-files",
  "version": "0.2.0",
  "description": "agent-trade/0.2 signed envelope: build, sign, serialize and four-step verify of LISTING_REF / DEAL / TRADE_EVENT / TRADE_RECEIPT files (module M2)",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/copy-schemas.mjs && tsc -b",
    "typecheck": "tsc -b",
    "pretest": "node scripts/copy-schemas.mjs",
    "test": "vitest run",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@agent-trade/identity": "file:../identity",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}

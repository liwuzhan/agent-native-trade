{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-trade.dev/schemas/trade-event.schema.json",
  "title": "TRADE_EVENT",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "object_type", "body", "body_hash", "signatures"],
  "properties": {
    "protocol": { "const": "agent-trade/0.2" },
    "object_type": { "const": "TRADE_EVENT" },
    "body_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/signature" }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "trade_id", "event_type", "actor", "occurred_at"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "trade_id": { "type": "string", "minLength": 1 },
        "event_type": {
          "enum": [
            "DEAL_SIGNED",
            "PAYMENT_REQUESTED",
            "PAYMENT_CONFIRMED",
            "ESCROWED",
            "FULFILLING",
            "SHIPPED",
            "DELIVERED",
            "COMPLETED",
            "DISPUTED",
            "RESOLVED",
            "CANCELLED"
          ]
        },
        "actor": { "$ref": "#/$defs/agentId" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "evidence": { "type": "object" },
        "message": { "type": "string" }
      }
    }
  },
  "$defs": {
    "agentId": { "type": "string", "minLength": 1 },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer", "algorithm", "signature", "issued_at"],
      "properties": {
        "signer": { "$ref": "#/$defs/agentId" },
        "algorithm": { "const": "Ed25519" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

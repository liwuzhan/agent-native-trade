{
  "name": "@agent-trade/local-store",
  "version": "0.2.0",
  "description": "agent-trade/0.2 local store: .data/ layout, SQLite index, trade state machine, append-only event log (module M3)",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@agent-trade/identity": "file:../identity",
    "@agent-trade/signed-files": "file:../signed-files"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
